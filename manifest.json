{
  "manifest_version": 3,
  "name": "Oasis Wallet",
  "short_name": "Oasis Wallet",
  "version": "0.3.0",
  "description": "A native-first, non-custodial Oasis wallet for Sapphire and Consensus, developed by Huralya.",
  "minimum_chrome_version": "113",
  "action": {
    "default_title": "Oasis Wallet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://sapphire.oasis.io/*",
    "https://testnet.sapphire.oasis.io/*",
    "https://nexus.oasis.io/*",
    "https://testnet.nexus.oasis.io/*",
    "https://grpc.oasis.io/*",
    "https://testnet.grpc.oasis.io/*",
    "https://raw.githubusercontent.com/bitcoin/bips/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
